# Copie para .env.local e preencha. Nunca versione valores reais.

# Postgres (local: docker compose). Em Vercel/Neon use a connection string pooled.
DATABASE_URL=postgres://louflow:louflow@localhost:54329/louflow
# Banco usado pelos testes (criado e recriado pelo setup do vitest)
DATABASE_URL_TEST=postgres://louflow:louflow@localhost:54329/louflow_test

# Segredo adicional aplicado ao PIN antes do hash (mínimo 32 caracteres)
PIN_PEPPER=

# Segredo exigido no cabeçalho Authorization das rotas /api/cron/*
CRON_SECRET=

# E-mail (S1-08). Sem chave, as notificações são registradas e não enviadas.
RESEND_API_KEY=
MAIL_FROM=

# URL pública da aplicação (links em e-mails)
APP_URL=http://localhost:3000

# Arquivos (conta sites-dev). Sem S3_BUCKET, os campos aceitam só link externo.
# O perfil encadeado usa a sessão SSO de shared. Não coloque chave de acesso aqui.
AWS_REGION=us-east-1
AWS_PROFILE=sites-dev-terraform
S3_BUCKET=louflow-app-private-796576080439
